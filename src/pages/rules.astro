---
import { u } from "../config/paths.js";
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import RulesCalculator from "../components/RulesCalculator.astro";
---

<BaseLayout
  title="Правила — Unionize"
  description="Повні правила настільної гри Unionize: відповіді на часті питання про клітинки, ППО, аукціони й перемогу, і калькулятор підсумкового результату гравця."
>
  <FaqAccordion />
  <RulesCalculator />

  <section class="rules-cta">
    <div class="container rules-cta__inner" data-reveal>
      <div>
        <p class="label rules-cta__label">Пункт 7 правил</p>
        <p class="rules-cta__text">Менше 1000 UC сумарних активів за столом? Є додаткова можливість поповнити рахунок.</p>
      </div>
      <a href={u("/tasks")} class="btn-outline">Додаткова можливість →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .rules-cta {
    padding-block: var(--space-16);
  }

  .rules-cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-8);
    border-radius: var(--r-3);
    background:
      radial-gradient(90% 140% at 0% 0%, rgba(228, 210, 166, .08), transparent 60%),
      var(--surf-1);
    box-shadow: var(--elev-2), var(--edge-ring-brass), var(--edge-top);
  }

  .rules-cta__label {
    color: var(--dim);
    margin-bottom: var(--space-2);
  }

  .rules-cta__text {
    color: var(--steel);
    max-width: 48ch;
  }

</style>
