---
import "../styles/global.css";
import "../styles/buttons.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Lighthouse from "../components/Lighthouse.astro";
import FloatingCTA from "../components/FloatingCTA.astro";
import ScrollTopButton from "../components/ScrollTopButton.astro";
import { SITE_URL, SITE_NAME } from "../config/site.js";
import { u } from "../config/paths.js";

const { title, description, ogImage = "/og-default.png" } = Astro.props;

// u() ідемпотентний, тож не важливо, чи Astro вже вклав базу в pathname
const canonicalUrl = new URL(u(Astro.url.pathname), SITE_URL).toString();
const ogImageUrl = new URL(u(ogImage), SITE_URL).toString();
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={u("/favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="icon" href={u("/favicon-16.png")} sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href={u("/apple-touch-icon.png")} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Lighthouse />
    <Footer />
    <FloatingCTA />
    <ScrollTopButton />
    <script>
      import "../scripts/reveal.ts";
    </script>
  </body>
</html>
