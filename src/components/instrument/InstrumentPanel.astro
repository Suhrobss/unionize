---
// «Прилад» (ДИЗАЙН-ТЗ §3.1/§3.4): гравійована сталева панель — зовнішній
// корпус для будь-якої числової/керованої поверхні сайту. З'являється не
// більше одного разу на видимий екран.
interface Props {
  label?: string;
}
const { label } = Astro.props;
---

<div class="instrument">
  {label && <p class="label instrument__label">{label}</p>}
  <div class="instrument__panel">
    <span class="instrument__screw instrument__screw--left" aria-hidden="true"></span>
    <span class="instrument__screw instrument__screw--right" aria-hidden="true"></span>
    <div class="instrument__content">
      <slot />
    </div>
  </div>
</div>

<style>
  .instrument__label {
    color: var(--dim);
    margin-bottom: var(--space-2);
  }

  .instrument__panel {
    position: relative;
    background: linear-gradient(176deg, var(--ink-600), var(--ink-700));
    border: var(--hairline-accent);
    border-radius: var(--r-2);
    padding: 16px;
  }

  @media (min-width: 561px) {
    .instrument__panel {
      padding: 26px;
    }
  }

  .instrument__screw {
    position: absolute;
    top: 14px;
    width: 9px;
    height: 9px;
    border-radius: var(--r-full);
    background: radial-gradient(circle at 34% 30%, #8e9aa4, #2e3b45 62%, #131c23);
  }

  .instrument__screw--left {
    left: 14px;
  }

  .instrument__screw--right {
    right: 14px;
  }
</style>
