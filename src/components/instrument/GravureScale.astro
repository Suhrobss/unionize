---
// Гравійована шкала (ДИЗАЙН-ТЗ §3.2А). Заповнення анімується через
// CSS-змінну --pct, яку виставляє клієнтський скрипт.
interface Props {
  id?: string;
  percent?: number;
}
const { id, percent = 0 } = Astro.props;
---

<div class="gscale" id={id} style={`--pct: ${percent}%`}>
  <div class="gscale__fill"></div>
  <div class="gscale__ticks"></div>
</div>

<style>
  .gscale {
    position: relative;
    height: 16px;
    overflow: hidden;
  }

  .gscale__fill {
    position: absolute;
    inset: 0;
    width: var(--pct, 0%);
    background: var(--champ);
    transition: width 900ms cubic-bezier(.16, 1, .28, 1);
  }

  .gscale__ticks {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(90deg, rgba(244, 244, 240, .26) 0 1px, transparent 1px 20px),
      repeating-linear-gradient(90deg, rgba(228, 210, 166, .5) 0 2px, transparent 2px 120px);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .gscale__fill {
      transition: none;
    }
  }
</style>
