<button class="scroll-top" id="scroll-top" type="button" aria-label="Нагору">
  <span aria-hidden="true">↑</span>
</button>

<style>
  .scroll-top {
    position: fixed;
    z-index: 30;
    bottom: 84px;
    right: 20px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surf-1);
    border: 0;
    border-radius: var(--r-full);
    box-shadow: var(--elev-2), var(--edge-ring), var(--edge-top);
    color: var(--steel);
    font-size: 18px;
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition: opacity 240ms ease, transform 240ms ease, background 200ms ease, color 200ms ease;
  }

  .scroll-top.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .scroll-top:hover {
    background: var(--surf-2);
    color: var(--champ);
    box-shadow: var(--elev-3), var(--edge-ring-brass), var(--edge-top-hi);
  }

  @media (min-width: 861px) {
    .scroll-top {
      bottom: 96px;
      right: 32px;
    }
  }
</style>

<script>
  const btn = document.getElementById("scroll-top");

  let ticking = false;

  function update() {
    if (btn) btn.classList.toggle("is-visible", window.scrollY > 300);
    ticking = false;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    },
    { passive: true }
  );

  btn?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  update();
</script>
