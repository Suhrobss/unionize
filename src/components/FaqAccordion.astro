---
import faqData from "../../data/faq.json";
import { highlightNumbers } from "../utils/highlightNumbers";

interface FaqBlock {
  type: "p" | "list" | "subhead";
  text?: string;
  items?: string[];
}
interface FaqQuestion {
  id: string;
  category: string;
  question: string;
  answer: FaqBlock[];
}
interface FaqCategory {
  key: string;
  label: string;
  title: string;
}

const categories = faqData.categories as FaqCategory[];
const questions = faqData.questions as FaqQuestion[];
---

<section class="faq" id="faq">
  <div class="container">
    <h2 class="faq__title">Правила / FAQ</h2>

    <div class="faq__chips" role="group" aria-label="Фільтр питань за розділом">
      <button class="chip is-active" type="button" data-filter="all">Усі</button>
      {categories.map((c) => (
        <button class="chip" type="button" data-filter={c.key}>{c.label}</button>
      ))}
    </div>

    <div class="faq__list" id="faq-list" data-reveal>
      {questions.map((q) => (
        <div class="faq-row" data-category={q.category}>
          <button class="faq-row__trigger" aria-expanded="false">
            <span class="faq-row__question">{q.question}</span>
            <span class="faq-row__arrow" aria-hidden="true"></span>
          </button>
          <div class="faq-row__panel">
            <div class="faq-row__answer">
              {q.answer.map((block) => {
                if (block.type === "list") {
                  return (
                    <ul class="faq-row__list">
                      {block.items?.map((item) => (
                        <li set:html={highlightNumbers(item)} />
                      ))}
                    </ul>
                  );
                }
                if (block.type === "subhead") {
                  return <p class="faq-row__subhead" set:html={highlightNumbers(block.text ?? "")} />;
                }
                return <p class="faq-row__p" set:html={highlightNumbers(block.text ?? "")} />;
              })}
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="faq__empty" id="faq-empty" hidden>
      <p>У цьому розділі поки немає питань. Подивіться всі правила.</p>
      <button class="btn-outline" type="button" id="faq-show-all">Показати всі</button>
    </div>
  </div>
</section>

<style>
  .faq {
    padding-block: var(--space-16);
  }

  @media (min-width: 861px) {
    .faq {
      padding-block: var(--space-24);
    }
  }

  .faq__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2rem, 6vw, 4rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-6);
  }

  .faq__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .chip {
    padding: 9px 16px;
    border-radius: 999px;
    border: 0;
    background: var(--surf-1);
    box-shadow: var(--elev-1), var(--edge-ring), var(--edge-top);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--steel);
    transition:
      background 200ms ease,
      color 200ms ease,
      box-shadow 200ms ease,
      transform 200ms var(--ease-out);
  }

  @media (hover: hover) {
    .chip:hover {
      transform: translateY(-2px);
      color: var(--champ);
      box-shadow: var(--elev-2), var(--edge-ring-brass), var(--edge-top-hi);
    }
  }

  .chip.is-active {
    background: linear-gradient(180deg, #D9BC7C 0%, #C2A059 46%, #A98741 100%);
    color: #1A1204;
    box-shadow:
      var(--shadow-brass),
      inset 0 1px 0 rgba(255, 246, 224, .55);
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* Було: рядки, розділені волосками, — виглядало як неоформлений список.
     Стало: кожне питання — окрема піднята картка. */
  .faq-row {
    border-radius: var(--r-2);
    background: var(--surf-1);
    box-shadow: var(--elev-1), var(--edge-ring), var(--edge-top);
    transition: box-shadow 280ms ease, background 280ms ease;
  }

  /* Фільтр ховає рядки через атрибут hidden. Правила вище не задають
     display, але додаємо явно: варто помилково поставити .faq-row у flex
     чи grid — і атрибут перестане діяти без жодної помилки в консолі. */
  .faq-row[hidden] {
    display: none;
  }

  .faq-row.is-open {
    background: var(--surf-2);
    box-shadow: var(--elev-2), var(--edge-ring-brass), var(--edge-top-hi);
  }

  @media (hover: hover) {
    .faq-row:not(.is-open):hover {
      background: var(--surf-2);
      box-shadow: var(--elev-2), var(--edge-ring), var(--edge-top-hi);
    }
  }

  .faq-row__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 20px 22px;
    border-radius: var(--r-2);
    position: relative;
    text-align: left;
  }

  .faq-row__question {
    font-weight: 500;
    font-size: 1.0625rem;
    color: var(--bone);
    transition: color 200ms ease;
  }

  .faq-row__trigger:hover .faq-row__question,
  .faq-row.is-open .faq-row__question {
    color: var(--champ);
  }

  .faq-row__trigger:focus-visible {
    outline: 2px solid var(--champ);
    outline-offset: -2px;
  }

  /* Стрілка сидить у власному заглибленні — маленький орган керування,
     а не значок, приклеєний до тексту. */
  .faq-row__arrow {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: var(--r-full);
    background: var(--surf-sunk);
    box-shadow: var(--edge-ring);
    transition: transform 280ms var(--ease-out), box-shadow 200ms ease;
  }

  .faq-row__arrow::before {
    content: "";
    width: 7px;
    height: 7px;
    background: var(--steel);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
    transform: translateX(1px);
    transition: background 200ms ease;
  }

  .faq-row__trigger:hover .faq-row__arrow {
    box-shadow: var(--edge-ring-brass);
  }

  .faq-row__trigger:hover .faq-row__arrow::before,
  .faq-row.is-open .faq-row__arrow::before {
    background: var(--champ);
  }

  .faq-row.is-open .faq-row__arrow {
    transform: rotate(90deg);
    box-shadow: var(--edge-ring-brass);
  }

  .faq-row__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 320ms var(--ease-out);
  }

  .faq-row.is-open .faq-row__panel {
    grid-template-rows: 1fr;
  }

  .faq-row__answer {
    overflow: hidden;
    padding-inline: 22px;
  }

  /* Волосок-роздільник між питанням і відповіддю — з'являється тільки
     у розкритому стані, інакше картка виглядає розрізаною завжди. */
  .faq-row.is-open .faq-row__answer > :first-child {
    border-top: var(--hairline);
    padding-top: var(--space-4);
  }

  .faq-row__p,
  .faq-row__subhead {
    max-width: 68ch;
    color: var(--steel);
    padding-bottom: var(--space-2);
  }

  .faq-row__p:last-child,
  .faq-row__subhead:last-child {
    padding-bottom: 20px;
  }

  .faq-row__subhead {
    font-weight: 600;
    color: var(--bone);
  }

  .faq-row__list {
    max-width: 68ch;
    margin: 0 0 20px;
    padding-left: 1.1em;
    color: var(--steel);
  }

  .faq-row__list li {
    padding-bottom: var(--space-2);
  }

  .faq-row__list li::marker {
    color: var(--brass);
  }

  .faq-row__p :global(.num),
  .faq-row__subhead :global(.num),
  .faq-row__list :global(.num) {
    font-family: var(--font-mono);
    font-weight: 700;
    color: inherit;
  }

  .faq-row__p :global(.num--uc),
  .faq-row__subhead :global(.num--uc),
  .faq-row__list :global(.num--uc) {
    color: var(--champ);
  }

  .faq-row__p :global(.num--rating),
  .faq-row__subhead :global(.num--rating),
  .faq-row__list :global(.num--rating) {
    color: var(--lyman);
  }

  .faq__empty {
    margin-top: var(--space-4);
    padding: var(--space-8) var(--space-6);
    border-radius: var(--r-2);
    background: var(--surf-sunk);
    box-shadow: var(--edge-ring);
    color: var(--steel);
  }

  .faq__empty[hidden] {
    display: none;
  }

  .btn-outline {
    margin-top: var(--space-4);
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
  const rows = document.querySelectorAll<HTMLDivElement>(".faq-row");
  const emptyState = document.getElementById("faq-empty");
  const showAllBtn = document.getElementById("faq-show-all");

  function applyFilter(key: string) {
    let visibleCount = 0;
    rows.forEach((row) => {
      const matches = key === "all" || row.dataset.category === key;
      row.hidden = !matches;
      if (matches) visibleCount += 1;
    });
    emptyState?.toggleAttribute("hidden", visibleCount !== 0);
    chips.forEach((chip) => chip.classList.toggle("is-active", chip.dataset.filter === key));
  }

  chips.forEach((chip) => {
    chip.addEventListener("click", () => applyFilter(chip.dataset.filter ?? "all"));
  });

  showAllBtn?.addEventListener("click", () => applyFilter("all"));

  document.querySelectorAll<HTMLButtonElement>(".faq-row__trigger").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const row = trigger.closest(".faq-row");
      const isOpen = row?.classList.toggle("is-open");
      trigger.setAttribute("aria-expanded", String(Boolean(isOpen)));
    });
  });
</script>
