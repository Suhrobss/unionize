---
import { JOIN_FORM_URL } from "../config/links.js";
---

<a class="floating-cta" href={JOIN_FORM_URL} target="_blank" rel="noopener">
  Стань частиною ПРМТУ
</a>

<style>
  .floating-cta {
    position: fixed;
    z-index: 30;
    bottom: 20px;
    right: 20px;
    padding: 15px 26px;
    background: linear-gradient(180deg, #D9BC7C 0%, #C2A059 46%, #A98741 100%);
    box-shadow:
      var(--shadow-brass),
      inset 0 1px 0 rgba(255, 246, 224, .55),
      inset 0 -1px 0 rgba(74, 55, 17, .55);
    color: #1A1204;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: transform 240ms var(--ease-out), background 240ms ease-out, box-shadow 240ms ease-out,
      opacity 400ms ease;
  }

  .floating-cta:hover {
    transform: translateY(-2px);
    background: linear-gradient(180deg, #E6CB90 0%, #CDAC64 46%, #B4914A 100%);
    box-shadow:
      0 0 36px -8px rgba(228, 210, 166, .45),
      0 2px 4px rgba(0, 0, 0, .6),
      0 18px 34px -12px rgba(0, 0, 0, .85),
      inset 0 1px 0 rgba(255, 246, 224, .65),
      inset 0 -1px 0 rgba(74, 55, 17, .55);
  }

  .floating-cta:focus-visible {
    outline: 2px solid var(--bone);
    outline-offset: 3px;
  }

  @media (min-width: 861px) {
    .floating-cta {
      bottom: 32px;
      right: 32px;
    }
  }
</style>
