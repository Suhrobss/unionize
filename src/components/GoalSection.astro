---
const GOALS = [
  {
    title: "Навчання через гру",
    text: "Зрозуміти основні принципи роботи профспілки в інтерактивному та захоплюючому форматі настільної гри.",
  },
  {
    title: "Стратегічне мислення",
    text: "Розвинути навички прийняття рішень, планування ресурсів та вирішення кризових ситуацій у профспілковій діяльності.",
  },
  {
    title: "Командна робота",
    text: "Сприяти розумінню важливості співпраці, переговорів та колективних дій для досягнення спільних цілей.",
  },
  {
    title: "Перемога",
    text: "Набрати найбільшу кількість балів через ефективне управління ресурсами, вирішення проблем та розвиток профспілкової організації.",
  },
];
---

<section class="goal" id="goal">
  <div class="container">
    <h2 class="goal__title">Мета гри</h2>
    <div class="goal__grid">
      {GOALS.map((goal, i) => (
        <div class="goal__item" data-reveal data-reveal-group="goal">
          <p class="label goal__number">{String(i + 1).padStart(2, "0")}</p>
          <h3 class="goal__item-title">{goal.title}</h3>
          <span class="goal__rule" aria-hidden="true"></span>
          <p class="goal__text">{goal.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .goal {
    padding-block: var(--space-16);
  }

  @media (min-width: 861px) {
    .goal {
      padding-block: var(--space-24);
    }
  }

  .goal__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2rem, 6vw, 4rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-6);
  }

  .goal__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 561px) {
    .goal__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4);
    }
  }

  /* Було: плитки на сітці з проміжком 1px — читалося як таблиця.
     Стало: окремі підняті картки. Поверхня з переходом згори вниз плюс
     світлий волосок на верхньому краї = блок ловить світло й має фаску. */
  .goal__item {
    position: relative;
    padding: 28px 26px 30px;
    border-radius: var(--r-2);
    background: var(--surf-1);
    box-shadow: var(--elev-1), var(--edge-ring), var(--edge-top);
    transition:
      transform 320ms var(--ease-out),
      box-shadow 320ms var(--ease-out),
      background 320ms ease;
  }

  /* Латунна дуга світла в лівому верхньому куті картки — тільки натяк,
     що джерело світла спільне для всієї сторінки. */
  .goal__item::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(120% 90% at 0% 0%, rgba(228, 210, 166, .07), transparent 58%);
  }

  @media (hover: hover) {
    .goal__item:hover {
      transform: translateY(-4px);
      background: var(--surf-2);
      box-shadow: var(--elev-3), var(--edge-ring-brass), var(--edge-top-hi);
    }
  }

  .goal__number {
    position: relative;
    color: var(--brass);
  }

  .goal__item-title {
    position: relative;
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--bone);
  }

  .goal__rule {
    position: relative;
    display: block;
    width: 28px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--champ), rgba(185, 146, 74, 0));
    margin-block: var(--space-3);
    transition: width 320ms var(--ease-out);
  }

  @media (hover: hover) {
    .goal__item:hover .goal__rule {
      width: 56px;
    }
  }

  .goal__text {
    position: relative;
    color: var(--steel);
  }
</style>